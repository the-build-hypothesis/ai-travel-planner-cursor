{
  "name": "ai-travel-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "vite build && node scripts/write-build-info.mjs",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "cf:build": "npm run build",
    "cf:deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply bh-travel-v1-claude-cursor-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply bh-travel-v1-claude-cursor-db --remote",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.10.3",
    "leaflet": "^1.9.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.9.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.45.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
